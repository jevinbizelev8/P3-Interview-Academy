option_settings:
  # Configure HTTPS listener on port 443 for Classic Load Balancer
  aws:elb:listener:443:
    ListenerProtocol: HTTPS
    InstancePort: 80
    InstanceProtocol: HTTP
    SSLCertificateId: arn:aws:acm:ap-southeast-1:417132395013:certificate/584a13c1-867e-40f0-a4d1-2428d595218b

  # Keep existing HTTP listener on port 80
  aws:elb:listener:80:
    ListenerProtocol: HTTP
    InstancePort: 80
    InstanceProtocol: HTTP
    ListenerEnabled: 'true'

  # Enable connection draining
  aws:elb:policies:
    ConnectionDrainingEnabled: true
    ConnectionDrainingTimeout: 20

  # Health check configuration
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

  # Application environment variables for HTTPS and CORS
  aws:elasticbeanstalk:application:environment:
    FORCE_HTTPS: 'true'
    WS_ALLOWED_ORIGINS: 'https://www.bizelev8.ai,https://bizelev8.ai,https://p3app.bizelev8.ai'

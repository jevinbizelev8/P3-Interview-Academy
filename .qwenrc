# Qwen Code CLI Configuration
# This file is sourced before running qwen commands

# Map QWEN_API_KEY from Replit secrets to OPENAI_API_KEY
export OPENAI_API_KEY="${QWEN_API_KEY}"

# Qwen API Configuration (International)
export OPENAI_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
export OPENAI_MODEL="qwen3-coder-plus"

# Alternative models you can use:
# - qwen3-coder-plus (default, most capable)
# - qwen3-coder-base
# - qwen-coder-turbo

# For Mainland China, use:
# export OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

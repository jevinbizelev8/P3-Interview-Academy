# AI Services Configuration
# OpenAI is the primary AI provider (required)
OPENAI_API_KEY=your_openai_api_key_here

# Optional AI providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# QWEN_API_KEY=your_qwen_api_key_here  # Coming in 3 months (Alicloud Qwen integration)

# Database Configuration
DATABASE_URL=your_database_url_here

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=P3 Interview Academy

# Application URLs
APP_URL_DEV=http://localhost:5000
APP_URL_PROD=https://your-production-domain.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=/dashboard
GOOGLE_FAILURE_REDIRECT=/?authError=google
VITE_ENABLE_GOOGLE_OAUTH=false

# Replit Auth Configuration
REPL_ID=your_repl_id_here
SESSION_SECRET=your_session_secret_here
ISSUER_URL=https://replit.com/oidc
REPLIT_DOMAINS=your-domain.replit.dev

# Development Configuration
NODE_ENV=development

# Authentication Control
# Set to "true" to bypass authentication in development (NOT FOR PRODUCTION)
# When enabled, uses mock user for testing. NEVER set to true in production!
BYPASS_AUTH=false

# Stripe Payment Configuration
# Toggle between test and live mode (use "test" for development/staging, "live" for production)
STRIPE_MODE=test

# Stripe Test Keys (for development and staging)
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_TEST_WEBHOOK_SECRET=whsec_your_test_webhook_signing_secret_here

# Stripe Live Keys (for production only)
STRIPE_LIVE_SECRET_KEY=sk_live_your_live_secret_key_here
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
STRIPE_LIVE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_secret_here

# Stripe Checkout URLs (change based on environment)
STRIPE_SUCCESS_URL=http://localhost:5000/billing?success=true
STRIPE_CANCEL_URL=http://localhost:5000/billing?canceled=true

# Stripe Price IDs (automatically populated by setup-stripe-products.ts script)
# These will be generated after running: npx tsx server/scripts/setup-stripe-products.ts
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ADVANCED_MONTHLY=price_xxx
STRIPE_PRICE_TOPUP_100=price_xxx
STRIPE_PRICE_TOPUP_500=price_xxx
STRIPE_PRICE_TOPUP_2000=price_xxx

# Telegram Bot Configuration
# Used for Claude Code Controller integration (AFK notifications and mobile approvals)
# Get these values by creating a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# The webhook URL should point to your Replit or deployed server
# Format: https://your-repl-name.your-username.repl.co/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-repl-name.your-username.repl.co/telegram/webhook

# Feature Flags - MVP Conversion (Base44 → P3 API)
# Control visibility of MVP pages during gradual rollout
# Set to "true" to enable converted pages (default: false for safety)
# WARNING: Only enable after conversion is complete and tested!
VITE_MVP_HOME_ENABLED=false
VITE_MVP_DASHBOARD_ENABLED=false
VITE_MVP_LAYOUT_ENABLED=false
VITE_MVP_COMPONENTS_ENABLED=false

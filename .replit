[[ports]]
localPort = 46793
externalPort = 5000

[agent]
integrations = ["javascript_anthropic==1.0.0", "javascript_log_in_with_replit==1.0.0", "javascript_openai==1.0.0", "javascript_database==1.0.0"]
expertMode = true

# AWS Elastic Beanstalk SSL/HTTPS Configuration
#
# PURPOSE: Enable HTTPS with SSL certificate, HTTP to HTTPS redirect, and security headers
# ENVIRONMENTS: Staging (p3app-staging.bizelev8.ai) and Production (p3app.bizelev8.ai)
#
# FEATURES:
# 1. HTTPS listener on port 443 with ACM certificate
# 2. Automatic HTTP to HTTPS redirect (301 permanent redirect)
# 3. Security headers (HSTS, X-Frame-Options, X-Content-Type-Options, X-XSS-Protection)
#
# UPDATED: 2025-11-05 - Added HTTP redirect and security headers

option_settings:
  # Enable HTTPS listener on port 443
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    Protocol: HTTPS
    # Staging certificate for p3app-staging.bizelev8.ai
    SSLCertificateArns: 'arn:aws:acm:ap-southeast-1:417132395013:certificate/8e2e99dd-dc3b-4538-a433-51796d33b355'
    DefaultProcess: default

  # HTTP listener on port 80 - will be redirected to HTTPS via CloudFormation resource below
  aws:elbv2:listener:default:
    ListenerEnabled: 'true'
    Protocol: HTTP

  # Load balancer configuration
  aws:elbv2:loadbalancer:
    ManagedSecurityGroup: '${aws:elbv2:loadbalancer:SecurityGroups}'
    SecurityGroups: '${aws:elbv2:loadbalancer:SecurityGroups}'
    IdleTimeout: 60

  # Process configuration for backend instances (HTTP, not HTTPS)
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    HealthCheckInterval: 30
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    Port: '80'
    Protocol: HTTP
    DeregistrationDelay: 20
    StickinessEnabled: 'false'

# CloudFormation Resources
Resources:
  # HTTP to HTTPS redirect (overwrites default HTTP listener)
  AWSEBV2LoadBalancerListenerHTTP:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: redirect
          RedirectConfig:
            Protocol: HTTPS
            Port: '443'
            Host: '#{host}'
            Path: '/#{path}'
            Query: '#{query}'
            StatusCode: HTTP_301
      LoadBalancerArn:
        Ref: AWSEBV2LoadBalancer
      Port: 80
      Protocol: HTTP

  # Allow HTTPS (443) inbound traffic
  HTTPSIngressRule:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
      Description: 'Allow HTTPS traffic for secure connections and Stripe webhooks'

# Nginx configuration for security headers
files:
  "/etc/nginx/conf.d/https_custom_config.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Security headers - applied to all responses
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-XSS-Protection "1; mode=block" always;

      # Additional security headers
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

container_commands:
  01_reload_nginx:
    command: "sudo service nginx reload"
    ignoreErrors: true

# DEPLOYMENT INSTRUCTIONS:
#
# This configuration is now ready for deployment to staging environment.
# For production, change the SSLCertificateArns to production certificate:
# arn:aws:acm:ap-southeast-1:417132395013:certificate/584a13c1-867e-40f0-a4d1-2428d595218b
#
# DEPLOY:
#   git add .ebextensions/04-ssl-https.config
#   git commit -m "feat: Enable HTTPS redirect and security headers"
#   git push
#
# VERIFY:
#   1. HTTP redirect: curl -I http://p3app-staging.bizelev8.ai/api/health/simple
#      Should return HTTP 301 with Location: https://...
#
#   2. HTTPS works: curl -I https://p3app-staging.bizelev8.ai/api/health/simple
#      Should return HTTP 200 OK
#
#   3. Security headers: curl -I https://p3app-staging.bizelev8.ai/api/health/simple
#      Should include: Strict-Transport-Security, X-Frame-Options, etc.
#
# TROUBLESHOOTING:
#
# - If HTTP still accessible without redirect:
#   → Check CloudFormation stack for AWSEBV2LoadBalancerListenerHTTP resource
#   → Verify listener configuration in AWS console
#
# - If security headers missing:
#   → SSH to instance and check /etc/nginx/conf.d/https_custom_config.conf exists
#   → Check nginx error logs: /var/log/nginx/error.log
#   → Verify nginx reloaded: sudo service nginx status
#
# - If certificate error:
#   → Verify certificate ARN matches environment (staging vs production)
#   → Check certificate status: aws acm describe-certificate --certificate-arn <ARN>

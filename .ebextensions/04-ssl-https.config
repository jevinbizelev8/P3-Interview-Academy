# AWS Elastic Beanstalk SSL/HTTPS Configuration
#
# PURPOSE: Enable HTTPS listener on Application Load Balancer for Stripe webhook support
# ENVIRONMENTS: Staging and Production
# PREREQUISITE: ACM certificate must be created and validated first
#
# SETUP INSTRUCTIONS:
# 1. Create ACM certificate following: MD_Documentations/Guides/AWS_SSL_HTTPS_SETUP.md
# 2. Replace {ACM_CERTIFICATE_ARN} below with your actual certificate ARN
# 3. Deploy this configuration to enable HTTPS
#
# NOTE: This config is for Application Load Balancer environments only.
# Single-instance environments must be converted to load-balanced first.

# IMPORTANT: Replace this with your actual ACM certificate ARN
# Format: arn:aws:acm:REGION:ACCOUNT_ID:certificate/CERTIFICATE_ID
# Example: arn:aws:acm:ap-southeast-1:123456789012:certificate/abcd1234-5678-90ab-cdef-1234567890ab
#
# To get certificate ARN:
# aws acm list-certificates --region ap-southeast-1 --query 'CertificateSummaryList[*].{Domain:DomainName,ARN:CertificateArn}' --output table
#
# STAGING CERTIFICATE ARN: {REPLACE_WITH_STAGING_CERT_ARN}
# PRODUCTION CERTIFICATE ARN: {REPLACE_WITH_PRODUCTION_CERT_ARN}

option_settings:
  # Enable HTTPS listener on port 443
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    Protocol: HTTPS
    SSLCertificateArns: '{ACM_CERTIFICATE_ARN}'  # REPLACE THIS
    DefaultProcess: default

  # HTTP listener on port 80 (optional - can redirect to HTTPS)
  aws:elbv2:listener:default:
    ListenerEnabled: 'true'
    Protocol: HTTP

  # Security group rules to allow HTTPS traffic
  aws:elbv2:loadbalancer:
    ManagedSecurityGroup: '${aws:elbv2:loadbalancer:SecurityGroups}'
    SecurityGroups: '${aws:elbv2:loadbalancer:SecurityGroups}'
    IdleTimeout: 60

  # Process configuration for backend instances (HTTP, not HTTPS)
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    HealthCheckInterval: 30
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    Port: '80'
    Protocol: HTTP
    DeregistrationDelay: 20
    StickinessEnabled: 'false'

# Optional: Redirect HTTP to HTTPS (uncomment to enable)
# Resources:
#   AWSEBV2LoadBalancerListenerHTTP:
#     Type: AWS::ElasticLoadBalancingV2::Listener
#     Properties:
#       DefaultActions:
#         - Type: redirect
#           RedirectConfig:
#             Protocol: HTTPS
#             Port: '443'
#             Host: '#{host}'
#             Path: '/#{path}'
#             Query: '#{query}'
#             StatusCode: HTTP_301
#       LoadBalancerArn:
#         Ref: AWSEBV2LoadBalancer
#       Port: 80
#       Protocol: HTTP

# Security group rules (allows HTTPS inbound)
Resources:
  # Allow HTTPS (443) inbound traffic
  HTTPSIngressRule:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
      Description: 'Allow HTTPS traffic for secure connections and Stripe webhooks'

# DEPLOYMENT STEPS:
#
# 1. CREATE ACM CERTIFICATE:
#    aws acm request-certificate \
#      --region ap-southeast-1 \
#      --domain-name your-domain.com \
#      --validation-method DNS
#
# 2. VALIDATE CERTIFICATE (add DNS records or email validation)
#    - Wait for certificate status to be "Issued"
#
# 3. GET CERTIFICATE ARN:
#    aws acm list-certificates --region ap-southeast-1 \
#      --query 'CertificateSummaryList[?DomainName==`your-domain.com`].CertificateArn' \
#      --output text
#
# 4. UPDATE THIS FILE:
#    - Replace {ACM_CERTIFICATE_ARN} with actual ARN
#
# 5. DEPLOY:
#    git add .ebextensions/04-ssl-https.config
#    git commit -m "feat: Enable HTTPS listener"
#    git push
#    eb deploy p3-interview-academy-staging
#
# 6. VERIFY:
#    curl https://p3-interview-academy-staging.eba-wdmrjtn2.ap-southeast-1.elasticbeanstalk.com/api/health
#
# 7. UPDATE STRIPE WEBHOOK:
#    - Add https://your-environment.elasticbeanstalk.com/api/webhooks/stripe
#    - Copy webhook signing secret to environment variables

# TROUBLESHOOTING:
#
# - If deployment fails with "Invalid certificate ARN":
#   → Verify certificate ARN is correct and in same region (ap-southeast-1)
#
# - If HTTPS returns 502 Bad Gateway:
#   → Check backend instances are healthy
#   → Verify health check path is accessible
#
# - If certificate validation pending:
#   → Check DNS records are correct
#   → Wait up to 30 minutes for validation
#
# - If "Single instance environment" error:
#   → Convert to load-balanced environment first
#   → See: MD_Documentations/Guides/AWS_SSL_HTTPS_SETUP.md

# REVERTING (if needed):
#
# To disable HTTPS and revert to HTTP-only:
# 1. Comment out the entire aws:elbv2:listener:443 section
# 2. Deploy the updated configuration
#
# Or remove this file entirely and redeploy:
# git rm .ebextensions/04-ssl-https.config
# git commit -m "revert: Remove HTTPS configuration"
# eb deploy

option_settings:
  # Enable load balancer HTTPS listener
  aws:elbv2:listener:443:
    DefaultProcess: default
    ListenerEnabled: 'true'
    Protocol: HTTPS
    SSLCertificateArns: 'arn:aws:acm:ap-southeast-1:YOUR_ACCOUNT_ID:certificate/YOUR_CERTIFICATE_ID'
    SSLPolicy: ELBSecurityPolicy-TLS-1-2-2017-01

  # Force HTTPS redirect for HTTP traffic
  aws:elbv2:listener:80:
    DefaultProcess: default
    ListenerEnabled: 'true'
    Protocol: HTTP
    Rules: |
      [
        {
          "Priority": 1,
          "Conditions": [
            {
              "Field": "host-header",
              "Values": ["p3app.bizelev8.ai"]
            }
          ],
          "Actions": [
            {
              "Type": "redirect",
              "RedirectConfig": {
                "Protocol": "HTTPS",
                "Port": "443",
                "StatusCode": "HTTP_301"
              }
            }
          ]
        }
      ]

  # Application environment variables for SSL
  aws:elasticbeanstalk:application:environment:
    FORCE_HTTPS: 'true'
    WS_ALLOWED_ORIGINS: 'https://www.bizelev8.ai,https://bizelev8.ai,https://p3app.bizelev8.ai'

commands:
  01_install_certbot:
    command: |
      if ! command -v certbot &> /dev/null; then
        yum update -y
        amazon-linux-extras install epel -y
        yum install -y certbot
      fi
    ignoreErrors: true

files:
  "/etc/nginx/conf.d/https.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # HTTPS and iframe embedding configuration
      server {
          listen 80;
          server_name p3app.bizelev8.ai;

          # Redirect HTTP to HTTPS
          return 301 https://$server_name$request_uri;
      }

      # Security headers for iframe embedding
      add_header X-Frame-Options "ALLOWALL" always;
      add_header Content-Security-Policy "frame-ancestors 'self' https://www.bizelev8.ai https://bizelev8.ai" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;

      # CORS headers for cross-origin embedding
      add_header Access-Control-Allow-Origin "https://www.bizelev8.ai" always;
      add_header Access-Control-Allow-Credentials "true" always;
      add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
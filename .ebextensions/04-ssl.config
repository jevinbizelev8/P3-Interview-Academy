option_settings:
  # Classic ELB HTTPS listener (already configured via AWS Console)
  # Note: The HTTPS listener with SSL certificate is already active on the Classic ELB
  # Certificate ARN: arn:aws:acm:ap-southeast-1:417132395013:certificate/584a13c1-867e-40f0-a4d1-2428d595218b
  # We don't need to reconfigure it here since it's managed at the ELB level

  # Application environment variables for SSL
  aws:elasticbeanstalk:application:environment:
    FORCE_HTTPS: 'true'
    WS_ALLOWED_ORIGINS: 'https://www.bizelev8.ai,https://bizelev8.ai,https://p3app.bizelev8.ai'

commands:
  01_install_certbot:
    command: |
      if ! command -v certbot &> /dev/null; then
        yum update -y
        amazon-linux-extras install epel -y
        yum install -y certbot
      fi
    ignoreErrors: true

files:
  "/etc/nginx/conf.d/https.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # HTTPS and iframe embedding configuration
      server {
          listen 80;
          server_name p3app.bizelev8.ai;

          # Redirect HTTP to HTTPS
          return 301 https://$server_name$request_uri;
      }

      # Security headers for iframe embedding
      add_header X-Frame-Options "ALLOWALL" always;
      add_header Content-Security-Policy "frame-ancestors 'self' https://www.bizelev8.ai https://bizelev8.ai" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;

      # CORS headers for cross-origin embedding
      add_header Access-Control-Allow-Origin "https://www.bizelev8.ai" always;
      add_header Access-Control-Allow-Credentials "true" always;
      add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
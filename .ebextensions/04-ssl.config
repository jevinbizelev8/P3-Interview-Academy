option_settings:
  # Application environment variables for HTTPS and CORS
  aws:elasticbeanstalk:application:environment:
    FORCE_HTTPS: 'true'
    WS_ALLOWED_ORIGINS: 'https://www.bizelev8.ai,https://bizelev8.ai,https://p3app.bizelev8.ai'

# Note: HTTPS listener with SSL certificate is already configured on the Classic ELB
# Certificate ARN: arn:aws:acm:ap-southeast-1:417132395013:certificate/584a13c1-867e-40f0-a4d1-2428d595218b
# SSL configuration is managed at the load balancer level via AWS Console

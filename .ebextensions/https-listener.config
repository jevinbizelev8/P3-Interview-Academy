option_settings:
  # Configure HTTPS listener on port 443
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:ap-southeast-1:417132395013:certificate/584a13c1-867e-40f0-a4d1-2428d595218b
    Rules: default

  # Keep existing HTTP listener on port 80
  aws:elbv2:listener:default:
    ListenerEnabled: 'true'

  # Enable connection draining
  aws:elb:policies:
    ConnectionDrainingEnabled: true
    ConnectionDrainingTimeout: 20

  # Health check configuration
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

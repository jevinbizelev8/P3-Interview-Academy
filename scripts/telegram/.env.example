# Telegram Bot Configuration
# Copy this file to .env and fill in your credentials

# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (can be personal or group chat)
# Get from @userinfobot or @getidsbot
CHAT_ID=your_chat_id_here

# Webhook URL for receiving Telegram messages (webhook server mode)
# Format: https://your-repl-name.your-username.repl.co/telegram/webhook
# This is required for the webhook server to process replies from Telegram
WEBHOOK_URL=https://your-repl-name.your-username.repl.co/telegram/webhook

# Optional: Custom API endpoint (leave blank for default)
# TELEGRAM_API_URL=https://api.telegram.org

# Optional: Notification settings
# NOTIFY_ON_ERROR=true
# NOTIFY_ON_DEPLOY=true
# NOTIFY_ON_APPROVAL=true

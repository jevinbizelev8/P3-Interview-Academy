# Production deployment optimization for AWS Elastic Beanstalk
# This configuration optimizes npm install for production environments

# Speed up installations
prefer-offline=true
audit=false
fund=false

# Production optimizations
production=true
optional=false

# Registry and cache settings
registry=https://registry.npmjs.org/
cache=/tmp/npm-cache

# Network optimization for cloud deployments
fetch-timeout=300000
fetch-retry-maxtimeout=120000
fetch-retry-mintimeout=10000

# Logging
loglevel=warn
progress=false